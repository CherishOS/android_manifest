  <project path="external/ant-wireless/ant_client" name="android_external_ant-wireless_ant_client" groups="qcom" remote="cherish" />
  <project path="external/ant-wireless/ant_service" name="android_external_ant-wireless_ant_service" groups="qcom" remote="cherish" />
