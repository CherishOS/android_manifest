<?xml version="1.0" encoding="UTF-8"?>
<manifest>

  <!-- Github -->
  <remote  name="github"
           fetch="https://github.com/" />

  <remote  name="gitlab"
           fetch="https://gitlab.com/" />

  <!-- GitHub -->
  <remote  name="cherish"
           fetch="https://github.com/CherishOS"
           revision="refs/heads/sixteen" />
	
  <!-- GitHub -->
  <remote  name="cherish-devices"
           fetch="https://github.com/CherishOS-Devices/"
           revision="tiramisu" />

  <!-- GitLab -->
  <remote name="cherish-gitlab"
          fetch="https://gitlab.com/CherishOS-A14"
          revision="udc" />

  <!-- Codeberg -->
  <remote  name="cherish-codeberg"
           fetch="https://codeberg.org/CherishOS"
           revision="refs/heads/sixteen" />

  <!-- Rootdir -->
  <project path="art" name="android_art" remote="cherish"  />
  <project path="bionic" name="android_bionic" remote="cherish"  />
  <project path="manifest" name="android_manifest" remote="cherish"  />

  <!-- Bootable -->
  <project path="bootable/deprecated-ota" name="android_bootable_deprecated-ota" groups="pdk-cw" remote="cherish" />
  <project path="bootable/recovery" name="android_bootable_recovery" remote="cherish"  />
  
  <!-- Build -->
  <project path="build/bazel" name="android_build_bazel" groups="pdk" remote="cherish" >
    <linkfile src="bazel.WORKSPACE" dest="WORKSPACE" />
    <linkfile src="bazel.BUILD" dest="BUILD" />
  </project>

  <!-- Build -->
  <project path="build/make" name="android_build" groups="pdk,sysui-studio" remote="cherish" >
    <copyfile dest="Makefile" src="core/root.mk" />
    <linkfile dest="build/CleanSpec.mk" src="CleanSpec.mk" />
    <linkfile dest="build/buildspec.mk.default" src="buildspec.mk.default" />
    <linkfile dest="build/core" src="core" />
    <linkfile dest="build/envsetup.sh" src="envsetup.sh" />
    <linkfile dest="build/target" src="target" />
    <linkfile dest="build/tools" src="tools" />
  </project>
  <project path="build/soong" name="android_build_soong" groups="pdk,tradefed" remote="cherish" >
    <linkfile dest="Android.bp" src="root.bp" />
    <linkfile dest="bootstrap.bash" src="bootstrap.bash" />
  </project>

  <!-- CodeLinaro additions -->
  <project path="device/cherish/sepolicy" name="android_device_cherish_sepolicy" remote="cherish" />
  <project path="device/qcom/sepolicy" name="android_device_qcom_sepolicy" remote="cherish" />
  <project path="device/qcom/sepolicy-legacy-um" name="android_device_qcom_sepolicy-legacy-um" remote="cherish" />
